{
  "name": "appshelf-github-pages",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-catalog.mjs --out dist",
    "validate": "node scripts/validate-catalog.mjs",
    "validate:artifacts": "node scripts/validate-project-artifacts.mjs",
    "test": "npm run validate && npm run validate:artifacts && node scripts/test-catalog.mjs && npm run test:web && npm run test:aufbrauchen && npm run test:offer",
    "test:browser": "node scripts/test-site-browser.mjs",
    "test:web": "node --test web-apps/tests/model.test.mjs",
    "test:web:browser": "node web-apps/tests/browser.mjs",
    "package:web": "python3 scripts/package-web-apps.py",
    "test:aufbrauchen": "npm test --prefix projects/Aufbrauchen",
    "test:offer": "node --check site/assets/service-request.js && node --test scripts/service-request.test.mjs"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
