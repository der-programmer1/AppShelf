{
  "name": "appshelf-github-pages",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-catalog.mjs --out dist",
    "validate": "node scripts/validate-catalog.mjs",
    "validate:artifacts": "node scripts/validate-project-artifacts.mjs",
    "test": "npm run validate && npm run validate:artifacts && node scripts/test-catalog.mjs && node --test scripts/test-updates.mjs scripts/test-automatic-updates.mjs && npm run test:web",
    "test:browser": "node scripts/test-news-browser.mjs",
    "test:web": "node --test web-apps/tests/model.test.mjs",
    "test:web:browser": "node web-apps/tests/browser.mjs",
    "package:web": "python3 scripts/package-web-apps.py"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
