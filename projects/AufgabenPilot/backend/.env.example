# Diesen Schlüssel ausschließlich auf dem Backend eintragen.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Eigenen Zugangscode erzeugen: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Dieser App-Zugangscode wird im Browser eingegeben; er ist NICHT der OpenAI-Key.
APP_ACCESS_TOKEN=
ALLOWED_ORIGINS=https://der-programmer1.github.io,http://localhost:8000,http://127.0.0.1:8000
RATE_LIMIT_PER_HOUR=20
AI_TIMEOUT_SECONDS=120
