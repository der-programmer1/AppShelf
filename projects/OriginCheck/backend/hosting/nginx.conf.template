worker_processes 1;
pid __RUNTIME_DIR__/nginx.pid;
error_log /dev/stderr crit;
events { worker_connections 128; }
http {
    access_log off;
    client_max_body_size 25000000;
    client_header_timeout 10s;
    client_body_timeout 45s;
    keepalive_timeout 5s;
    server_tokens off;
    client_body_temp_path __RUNTIME_DIR__/unused-body-cache;
    proxy_temp_path __RUNTIME_DIR__/unused-proxy-cache;
    fastcgi_temp_path __RUNTIME_DIR__/unused-fastcgi-cache;
    uwsgi_temp_path __RUNTIME_DIR__/unused-uwsgi-cache;
    scgi_temp_path __RUNTIME_DIR__/unused-scgi-cache;
    server {
        listen 0.0.0.0:__PUBLIC_PORT__;
        server_name _;
        location / {
            proxy_pass https://127.0.0.1:8443;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header Connection "";
            proxy_set_header X-Forwarded-For "";
            proxy_set_header X-Forwarded-Proto "";
            proxy_request_buffering off;
            proxy_buffering off;
            proxy_cache off;
            proxy_read_timeout 50s;
            proxy_send_timeout 50s;
            proxy_ssl_server_name on;
            proxy_ssl_name localhost;
            proxy_ssl_protocols TLSv1.2 TLSv1.3;
            proxy_ssl_verify on;
            proxy_ssl_verify_depth 1;
            proxy_ssl_trusted_certificate __RUNTIME_DIR__/backend-cert.pem;
        }
    }
}
